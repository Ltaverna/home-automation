# Secretos
.env
*.pem
*.key
homeassistant/secrets.yaml
mosquitto/config/passwd

# Código de terceros gestionado por HACS (cubierto por el backup nocturno)
homeassistant/custom_components/

# Credenciales de túneles Cloudflare (secreto; en el backup nocturno)
cloudflared/*.json

# FaceEmbed: .deb de HailoRT (grandes, se bajan con apt-get download) y DB de caras
face-embed/*.deb
face-embed/data/

# Estado de runtime (no config)
homeassistant/.storage/
homeassistant/home-assistant.log*
homeassistant/home-assistant_v2.db*
homeassistant/.cloud/
homeassistant/deps/
homeassistant/tts/
zigbee2mqtt/log/
zigbee2mqtt/coordinator_backup.json
frigate/media/
esphome/.esphome/
mosquitto/data/
mosquitto/log/

# Sistema
__pycache__/
*.swp
.DS_Store

# Credenciales del backup off-site (restic + R2)
.restic-env

# Marker de último backup off-site (runtime, no config)
.last-backup-offsite

# Token de API de Cloudflare (Access/MCP portal)
.cloudflare-token
